<?xml version="1.0" encoding="utf-8"?>
<!--
    SPDX-License-Identifier: GPL-3.0-only

    Secondary toolbar: a full-width row of pinned toolbar buttons shown just
    below the main suggestion / toolbar strip. Keys share the available width
    evenly so they stay on-screen on narrow phones; 1dp start/end padding
    matches the first-row more-key and microphone edge inset.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/secondary_toolbar_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/config_secondary_toolbar_height"
    android:orientation="horizontal"
    android:paddingStart="1dp"
    android:paddingEnd="1dp"
    style="?attr/suggestionStripViewStyle">

    <LinearLayout
        android:id="@+id/pinned_keys"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        style="?attr/suggestionWordStyle" />

</LinearLayout>
